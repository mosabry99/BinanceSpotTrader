# Example environment file for the Crypto Trading Analysis Application
# Copy this file to .env and fill in your actual values.
# Do NOT commit your .env file to version control.

# --- Application Settings ---
# Set to "True" for detailed logging and debugging information.
# Default: "False"
DEBUG_MODE="False"


# --- Exchange API Configuration ---
# The exchange to connect to (e.g., binance, kucoin, bybit).
# Make sure the exchange is supported by the ccxt library.
# Default: "binance"
EXCHANGE="binance"

# Your API key from the exchange.
# Leave blank if you only want to use public data.
API_KEY=""

# Your API secret from the exchange.
# Leave blank if you only want to use public data.
API_SECRET=""

# Set to "True" to use the exchange's testnet/sandbox environment.
# This is highly recommended for testing.
# Default: "True"
USE_TESTNET="True"

# API request timeout in seconds.
# Default: "10"
API_TIMEOUT="10"


# --- Email Notification Settings (Optional) ---
# Set to "True" to enable email notifications for trades or alerts.
# Note: You might need to use an "App Password" for services like Gmail.
EMAIL_ENABLED="False"
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
EMAIL_USERNAME="your_email@example.com"
EMAIL_PASSWORD="your_email_password_or_app_password"
FROM_EMAIL="your_email@example.com"
TO_EMAIL="recipient_email@example.com"
