# Neural Pulse Scalper - Environment Variables
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit your actual .env file to version control

# Binance API Keys
# Testnet (for testing without real money)
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Mainnet (for live trading with real money)
BINANCE_MAINNET_API_KEY=your_mainnet_api_key_here
BINANCE_MAINNET_API_SECRET=your_mainnet_api_secret_here

# Trading Mode
# Set to "testnet" for paper trading or "mainnet" for live trading
TRADING_MODE=testnet

# Risk Management
# Override config.yaml settings if needed
POSITION_SIZE_PERCENTAGE=2.0
MAX_OPEN_TRADES=2
DAILY_MAX_DRAWDOWN_PCT=2.0

# Database Configuration
# Only needed if using MySQL or PostgreSQL instead of SQLite
DB_TYPE=sqlite  # sqlite, mysql, postgresql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=neural_pulse_scalper
DB_USER=dbuser
DB_PASSWORD=dbpassword

# Telegram Notifications (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Webhook Notifications (optional)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-url.com/trading-notifications

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# System Settings
TIMEZONE=UTC
DEBUG_MODE=false

# AI Model Settings
AI_ENABLED=true
MODEL_WIN_PROBABILITY_THRESHOLD=0.75

# Proxy Settings (optional)
USE_PROXY=false
PROXY_URL=http://your-proxy-url:port
